#https://www.hackerrank.com/challenges/the-report/problem
SELECT 
    CASE 
        WHEN Grade >= 8 THEN Name 
        ELSE NULL 
    END, 
    Grade, 
    Marks
FROM Students 
JOIN Grades 
  ON Marks BETWEEN Min_Mark AND Max_Mark
ORDER BY 
    Grade DESC, 
    CASE 
        WHEN Grade >= 8 THEN Name 
        ELSE NULL 
    END ASC, 
    Marks ASC;
